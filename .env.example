# MCloud PARTNER auth API (server-to-server; do NOT prefix NEXT_PUBLIC).
#
# Must be the CANONICAL host: www.mcloud.co.ke. The apex (mcloud.co.ke) issues a
# 308 redirect to www, and the redirect DROPS the x-partner-secret header, so
# MCloud replies 401 and this app surfaces a confusing 502. mcloud-client.ts sets
# redirect: "error" so a wrong host now fails loudly instead of silently.
#
# The partner routes are secret-gated (one known caller). The mobile routes
# (/api/mobile/auth) are unauthenticated and used by the mobile app; the web
# routes (/api/auth) set a same-origin-only cookie and are unusable from here.
MCLOUD_AUTH_BASE=https://www.mcloud.co.ke/api/partner/auth

# Sent as the x-partner-secret header. Must match PARTNER_AUTH_SECRET in
# MCloud's own (Vercel) env, or every call 401s.
PARTNER_AUTH_SECRET=

# Cloudflare Turnstile (bot challenge on /login send-code)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
